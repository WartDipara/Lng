{
  "expo": {
    "name": "English in Practice",
    "icon": "./assets/icon.png",
    "slug": "engdictionary",
    "version": "1.1.0",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "scheme": "engdictionary",
    "ios": { "supportsTablet": true, "bundleIdentifier": "com.engdictionary.practice", "infoPlist": { "UIFileSharingEnabled": true, "LSSupportsOpeningDocumentsInPlace": true } },
    "android": { "package": "com.engdictionary.practice", "versionCode": 3, "adaptiveIcon": { "foregroundImage": "./assets/icon.png", "backgroundColor": "#117B72" }, "permissions": [], "blockedPermissions": ["android.permission.RECORD_AUDIO", "android.permission.READ_MEDIA_AUDIO", "android.permission.READ_MEDIA_VIDEO", "android.permission.READ_MEDIA_IMAGES", "android.permission.READ_EXTERNAL_STORAGE", "android.permission.WRITE_EXTERNAL_STORAGE", "android.permission.SYSTEM_ALERT_WINDOW"] },
    "web": { "bundler": "metro", "name": "English in Practice" },
    "plugins": [["expo-asset", { "assets": ["./mobile/assets"] }], "expo-document-picker", "expo-sharing", "expo-font"],
    "updates": { "enabled": false }
  }
}
