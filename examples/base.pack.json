      "cefr": null,
      "status": "ready",
      "senses": [
        {
          "id": "example:contingent-dependent",
          "partOfSpeech": "adjective",
          "sourceIds": [
            "example:author"
          ],
          "definition": "Dependent on a condition being met.",
          "simpleDefinition": "Only possible if something else happens first.",
          "examples": [
            "The trip is contingent on good weather.",
            "The grant is contingent on final approval."
          ],
          "synonyms": [
            "dependent"
          ],
          "synonymNote": "Use contingent on when a result needs a condition to be met.",
          "collocations": [
            "contingent on approval"
          ],
          "status": "ready"
        }
      ]
    }
  ],
  "passages": [
    {
      "id": "example:library",
      "revision": 1,
      "sourceIds": [
        "example:author"
      ],
      "title": "A library trial",
      "paragraphs": [
        {
          "id": "paragraph:trial",
          "text": "A town library will test longer opening hours for six weeks. On Tuesdays it will close at eight rather than six. The extra hours depend on volunteers being available. The manager will count evening visits before deciding whether to continue."
        },
        {
          "id": "paragraph:view",
          "text": "The manager believes the trial could help workers who finish late, but warns that a small rise in visits would not by itself prove that permanent funding is worthwhile."
        }
      ]
    }
  ],
