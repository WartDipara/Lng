        "title": {
          "type": "string",
          "minLength": 1
        },
        "instructions": {
          "type": "string",
          "minLength": 1
        },
        "prompt": {
          "type": "string",
          "minLength": 1
        },
        "passageId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*:[A-Za-z0-9._~-]+$",
          "maxLength": 180
        },
        "passageRevision": {
          "type": "integer",
          "minimum": 1
        },
        "interaction": {
          "oneOf": [
            {
              "$ref": "#/$defs/choice"
            },
            {
              "$ref": "#/$defs/text"
            },
            {
              "$ref": "#/$defs/matching"
            },
            {
              "$ref": "#/$defs/ordering"
            }
          ]
        },
        "explanation": {
          "type": "string",
          "minLength": 1
