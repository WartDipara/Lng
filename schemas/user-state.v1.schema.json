            "type": "string",
            "minLength": 1
          }
        },
        "evidenceParagraphIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*:[A-Za-z0-9._~-]+$",
            "maxLength": 180
          },
          "minItems": 0
        },
        "senseIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*:[A-Za-z0-9._~-]+$",
            "maxLength": 180
          },
          "minItems": 0
        },
        "tags": {
