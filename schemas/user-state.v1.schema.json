                "question": {
                  "$ref": "#/$defs/question"
                },
                "passage": {
                  "$ref": "#/$defs/passage"
                },
                "answer": {},
                "attemptId": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]*:[A-Za-z0-9._~-]+$",
                  "maxLength": 180
                },
                "score": {
                  "type": "integer",
                  "minimum": 0
                },
                "maxScore": {
                  "type": "integer",
                  "minimum": 1
                }
