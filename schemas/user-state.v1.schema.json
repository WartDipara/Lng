{
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*:[A-Za-z0-9._~-]+$",
            "maxLength": 180
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "body": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          },
          "target": {
            "$ref": "#/$defs/target"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "title",
          "body",
          "tags",
          "createdAt",
          "updatedAt"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "attempts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*:[A-Za-z0-9._~-]+$",
            "maxLength": 180
          },
          "target": {
            "$ref": "#/$defs/target"
          },
          "kind": {
            "enum": [
              "question",
              "spelling",
              "recall"
            ]
          },
          "answer": {},
          "score": {
            "type": "number",
            "minimum": 0
          },
          "maxScore": {
            "type": "integer",
            "minimum": 1
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "target",
          "kind",
          "answer",
          "score",
          "maxScore",
          "createdAt"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "mistakes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "target": {
            "$ref": "#/$defs/target"
          },
          "attemptIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*:[A-Za-z0-9._~-]+$",
              "maxLength": 180
            },
            "minItems": 1
          },
          "mastered": {
            "type": "boolean"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "target",
          "attemptIds",
          "mastered",
          "updatedAt"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "reviews": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "target": {
            "$ref": "#/$defs/target"
          },
          "dueAt": {
            "type": "string",
            "format": "date-time"
          },
          "intervalDays": {
            "type": "number",
            "minimum": 0
          },
          "ease": {
            "type": "number",
            "minimum": 1.3
          },
          "repetitions": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "target",
          "dueAt",
          "intervalDays",
          "ease",
          "repetitions"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "settings": {
      "type": "object",
      "properties": {
        "dailyNewLimit": {
          "type": "integer",
          "minimum": 0
        },
        "selectedTags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        }
      },
      "required": [
        "dailyNewLimit",
        "selectedTags"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "notes",
    "attempts",
    "mistakes",
    "reviews",
    "settings"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engdictionary.local/schemas/user-state.v1.json",
  "$defs": {
    "target": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "question",
            "sense"
          ]
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*:[A-Za-z0-9._~-]+$",
          "maxLength": 180
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "kind",
        "id",
        "revision"
      ],
      "additionalProperties": false
    }
  }
}
