      },
      "required": [
        "id",
        "revision",
        "sourceIds",
        "type",
        "origin",
        "title",
        "instructions",
        "prompt",
        "interaction",
        "explanation",
        "evidenceParagraphIds",
        "senseIds",
        "tags"
      ],
      "additionalProperties": false
