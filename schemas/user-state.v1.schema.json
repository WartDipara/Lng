        "type": {
          "enum": [
            "comprehension",
            "error-identification",
            "sentence-completion",
            "paragraph-improvement",
            "true-false-not-given",
            "yes-no-not-given",
            "matching-headings",
            "matching-information",
            "matching-features",
            "matching-sentence-endings",
            "summary-completion",
            "note-completion",
            "table-completion",
            "flowchart-completion",
            "diagram-labelling",
            "short-answer",
            "multiple-choice-cloze",
            "open-cloze",
            "word-formation",
            "key-word-transformation",
            "dialogue",
            "scenario"
