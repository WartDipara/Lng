                "minItems": 0
              },
              "minItems": 0
            },
            "steps": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 0
            },
            "imageDataUri": {
              "type": "string",
              "pattern": "^data:image/(png|jpeg);base64,[A-Za-z0-9+/]+=*$"
            },
            "altText": {
              "type": "string",
              "minLength": 1
            },
            "labels": {
